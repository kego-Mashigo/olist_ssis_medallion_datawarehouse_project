            <component
              refId="Package\05_load_silver_order_payments\Read_bronze_order_payments"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="Read_bronze_order_payments"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH cleaned AS
(
    SELECT
        NULLIF(LTRIM(RTRIM(p.order_id)), N'') AS order_id_text,
        NULLIF(LTRIM(RTRIM(p.payment_sequential)), N'') AS sequence_text,
        NULLIF(LOWER(LTRIM(RTRIM(p.payment_type))), N'') AS payment_type_text,
        NULLIF(LTRIM(RTRIM(p.payment_installments)), N'') AS installments_text,
        NULLIF(LTRIM(RTRIM(p.payment_value)), N'') AS value_text,
        (
            SELECT
                p.order_id,
                p.payment_sequential,
                p.payment_type,
                p.payment_installments,
                p.payment_value
            FOR JSON PATH, INCLUDE_NULL_VALUES, WITHOUT_ARRAY_WRAPPER
        ) AS raw_row
    FROM bronze.order_payments AS p
),
typed AS
(
    SELECT *,
        TRY_CONVERT(INT, sequence_text) AS payment_sequential_clean,
        TRY_CONVERT(INT, installments_text) AS payment_installments_clean,
        TRY_CONVERT(DECIMAL(10,2), value_text) AS payment_value_clean
    FROM cleaned
),
key_checked AS
(
    SELECT *,
        COUNT_BIG(*) OVER
        (
            PARTITION BY order_id_text, payment_sequential_clean
        ) AS payment_key_count
    FROM typed
)
SELECT
    CAST(order_id_text AS NVARCHAR(50)) AS order_id_clean,
    payment_sequential_clean,
    CAST(COALESCE(payment_type_text, N'') AS NVARCHAR(100)) AS payment_type_trimmed,
    payment_installments_clean,
    payment_value_clean,
    CAST(COALESCE(order_id_text, N'') AS NVARCHAR(255)) AS order_id_for_log,
    CAST(COALESCE(sequence_text, N'') AS NVARCHAR(255)) AS sequence_for_log,
    CAST(
        CASE
            WHEN order_id_text IS NULL
                THEN N'Missing order_id'
            WHEN DATALENGTH(order_id_text) &gt; 100
                THEN N'order_id exceeds NVARCHAR(50)'
            WHEN payment_sequential_clean IS NULL OR payment_sequential_clean &lt; 1
                THEN N'Payment sequence must be a positive integer'
            WHEN payment_installments_clean IS NULL OR payment_installments_clean &lt; 0
                THEN N'Payment installments must be a nonnegative integer'
            WHEN payment_value_clean IS NULL
                THEN N'Payment value is blank, invalid, or out of range'
            WHEN LEFT(value_text, 1) = N'-'
                THEN N'Negative payment value'
            WHEN DATALENGTH(payment_type_text) &gt; 200
                THEN N'Payment type exceeds NVARCHAR(100)'
            WHEN payment_key_count &gt; 1
                THEN N'Duplicate order_id and payment_sequential'
            ELSE N''
        END AS NVARCHAR(100)
    ) AS validation_reason,
    raw_row
FROM key_checked;</property>
