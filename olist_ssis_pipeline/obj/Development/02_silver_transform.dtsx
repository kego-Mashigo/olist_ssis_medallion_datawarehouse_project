            <component
              refId="Package\05_load_silver_products\OLE DB Source_bronze_products"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source_bronze_products"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH raw_products AS
(
    SELECT
        product_id,
        product_category_name,
        NULLIF(LTRIM(RTRIM(product_name_lenght)), N'') AS name_raw,
        NULLIF(LTRIM(RTRIM(product_description_lenght)), N'') AS description_raw,
        NULLIF(LTRIM(RTRIM(product_photos_qty)), N'') AS photos_raw,
        NULLIF(LTRIM(RTRIM(product_weight_g)), N'') AS weight_raw,
        NULLIF(LTRIM(RTRIM(product_length_cm)), N'') AS length_raw,
        NULLIF(LTRIM(RTRIM(product_height_cm)), N'') AS height_raw,
        NULLIF(LTRIM(RTRIM(product_width_cm)), N'') AS width_raw
    FROM bronze.products
),
parsed_products AS
(
    SELECT
        *,
        TRY_CONVERT(decimal(38,18), name_raw) AS name_num,
        TRY_CONVERT(decimal(38,18), description_raw) AS description_num,
        TRY_CONVERT(decimal(38,18), photos_raw) AS photos_num,
        TRY_CONVERT(decimal(38,18), weight_raw) AS weight_num,
        TRY_CONVERT(decimal(38,18), length_raw) AS length_num,
        TRY_CONVERT(decimal(38,18), height_raw) AS height_num,
        TRY_CONVERT(decimal(38,18), width_raw) AS width_num
    FROM raw_products
),
typed_products AS
(
    SELECT
        *,
        CASE WHEN name_num &gt;= 0 AND name_num = FLOOR(name_num)
             THEN TRY_CONVERT(int, name_num)
        END AS product_name_length,
        CASE WHEN description_num &gt;= 0 AND description_num = FLOOR(description_num)
             THEN TRY_CONVERT(int, description_num)
        END AS product_description_length,
        CASE WHEN photos_num &gt;= 0 AND photos_num = FLOOR(photos_num)
             THEN TRY_CONVERT(int, photos_num)
        END AS product_photos_qty,
        CASE WHEN weight_num &gt;= 0
                  AND weight_num = TRY_CONVERT(decimal(10,2), weight_num)
             THEN TRY_CONVERT(decimal(10,2), weight_num)
        END AS product_weight_g,
        CASE WHEN length_num &gt;= 0
                  AND length_num = TRY_CONVERT(decimal(10,2), length_num)
             THEN TRY_CONVERT(decimal(10,2), length_num)
        END AS product_length_cm,
        CASE WHEN height_num &gt;= 0
                  AND height_num = TRY_CONVERT(decimal(10,2), height_num)
             THEN TRY_CONVERT(decimal(10,2), height_num)
        END AS product_height_cm,
        CASE WHEN width_num &gt;= 0
                  AND width_num = TRY_CONVERT(decimal(10,2), width_num)
             THEN TRY_CONVERT(decimal(10,2), width_num)
        END AS product_width_cm
    FROM parsed_products
)
SELECT
    product_id,
    product_category_name,
    product_name_length,
    product_description_length,
    product_photos_qty,
    product_weight_g,
    product_length_cm,
    product_height_cm,
    product_width_cm,
    CASE
        WHEN (name_raw IS NOT NULL AND product_name_length IS NULL)
          OR (description_raw IS NOT NULL AND product_description_length IS NULL)
          OR (photos_raw IS NOT NULL AND product_photos_qty IS NULL)
          OR (weight_raw IS NOT NULL AND product_weight_g IS NULL)
          OR (length_raw IS NOT NULL AND product_length_cm IS NULL)
          OR (height_raw IS NOT NULL AND product_height_cm IS NULL)
          OR (width_raw IS NOT NULL AND product_width_cm IS NULL)
        THEN 1
        ELSE 0
    END AS invalid_numeric
FROM typed_products;</property>
