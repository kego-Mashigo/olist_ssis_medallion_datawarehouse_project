                          dataType="System.String"
                          description="Derived Column Expression"
                          name="Expression">(DT_WSTR,255)([ISNULL](#{Package\05_load_silver_order_reviews\OLE DB Source_read_bronze_order_reviews.Outputs[OLE DB Source Output].Columns[review_id_clean]}) ? "Missing review_id" : [ISNULL](#{Package\05_load_silver_order_reviews\OLE DB Source_read_bronze_order_reviews.Outputs[OLE DB Source Output].Columns[order_id_clean]}) ? "Missing order_id" : [ISNULL](#{Package\05_load_silver_order_reviews\OLE DB Source_read_bronze_order_reviews.Outputs[OLE DB Source Output].Columns[review_score_clean]}) ? "Missing or invalid review_score" : (#{Package\05_load_silver_order_reviews\OLE DB Source_read_bronze_order_reviews.Outputs[OLE DB Source Output].Columns[review_score_clean]} &lt; 1 || #{Package\05_load_silver_order_reviews\OLE DB Source_read_bronze_order_reviews.Outputs[OLE DB Source Output].Columns[review_score_clean]} &gt; 5) ? "Review score outside 1 to 5" : [ISNULL](#{Package\05_load_silver_order_reviews\OLE DB Source_read_bronze_order_reviews.Outputs[OLE DB Source Output].Columns[review_creation_date_clean]}) ? "Missing or invalid review_creation_date" : [ISNULL](#{Package\05_load_silver_order_reviews\OLE DB Source_read_bronze_order_reviews.Outputs[OLE DB Source Output].Columns[review_answer_timestamp_clean]}) ? "Missing or invalid review_answer_timestamp" : "")</property>
