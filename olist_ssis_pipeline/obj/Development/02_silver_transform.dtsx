            <component
              refId="Package\05_load_silver_orders\OLE DB Source_read_bronze_orders"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source_read_bronze_orders"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH cleaned AS
(
    SELECT
        NULLIF(LTRIM(RTRIM(b.order_id)), N'') AS order_id_clean,
        NULLIF(LTRIM(RTRIM(b.customer_id)), N'') AS customer_id_clean,
        NULLIF(LOWER(LTRIM(RTRIM(b.order_status))), N'') AS order_status_clean,

        NULLIF(LTRIM(RTRIM(b.order_purchase_timestamp)), N'') AS purchase_text,
        NULLIF(LTRIM(RTRIM(b.order_approved_at)), N'') AS approved_text,
        NULLIF(LTRIM(RTRIM(b.order_delivered_carrier_date)), N'') AS carrier_text,
        NULLIF(LTRIM(RTRIM(b.order_delivered_customer_date)), N'') AS delivered_text,
        NULLIF(LTRIM(RTRIM(b.order_estimated_delivery_date)), N'') AS estimated_text,

        (
            SELECT
                b.order_id,
                b.customer_id,
                b.order_status,
                b.order_purchase_timestamp,
                b.order_approved_at,
                b.order_delivered_carrier_date,
                b.order_delivered_customer_date,
                b.order_estimated_delivery_date
            FOR JSON PATH, INCLUDE_NULL_VALUES, WITHOUT_ARRAY_WRAPPER
        ) AS raw_row
    FROM bronze.orders AS b
),
typed AS
(
    SELECT
        *,
        TRY_CONVERT(DATETIME2(7), purchase_text, 120) AS order_purchase_timestamp,
        TRY_CONVERT(DATETIME2(7), approved_text, 120) AS order_approved_at,
        TRY_CONVERT(DATETIME2(7), carrier_text, 120) AS order_delivered_carrier_date,
        TRY_CONVERT(DATETIME2(7), delivered_text, 120) AS order_delivered_customer_date,
        TRY_CONVERT(DATETIME2(7), estimated_text, 120) AS order_estimated_delivery_date
    FROM cleaned
)
SELECT
    order_id_clean,
    customer_id_clean,
    order_status_clean,
    order_purchase_timestamp,
    order_approved_at,
    order_delivered_carrier_date,
    order_delivered_customer_date,
    order_estimated_delivery_date,
    raw_row,
    CAST(CASE
        WHEN order_id_clean IS NULL THEN N'Missing order_id'
        WHEN customer_id_clean IS NULL THEN N'Missing customer_id'
        WHEN purchase_text IS NULL THEN N'Missing purchase timestamp'
        WHEN order_purchase_timestamp IS NULL THEN N'Invalid purchase timestamp'
        WHEN approved_text IS NOT NULL AND order_approved_at IS NULL
            THEN N'Invalid approval timestamp'
        WHEN carrier_text IS NOT NULL AND order_delivered_carrier_date IS NULL
            THEN N'Invalid carrier delivery timestamp'
        WHEN delivered_text IS NOT NULL AND order_delivered_customer_date IS NULL
            THEN N'Invalid customer delivery timestamp'
        WHEN estimated_text IS NOT NULL AND order_estimated_delivery_date IS NULL
            THEN N'Invalid estimated delivery timestamp'
        ELSE N''
    END AS NVARCHAR(128)) AS reject_reason
FROM typed;</property>
                <property
                  dataType="System.String"
                  description="The variable that contains the SQL command to be executed."
                  name="SqlCommandVariable"></property>
                <property
                  dataType="System.Int32"
                  description="Specifies the column code page to use when code page information is unavailable from the data source."
                  name="DefaultCodePage">1252</property>
                <property
                  dataType="System.Boolean"
                  description="Forces the use of the DefaultCodePage property value when describing character data."
                  name="AlwaysUseDefaultCodePage">false</property>
                <property
                  dataType="System.Int32"
