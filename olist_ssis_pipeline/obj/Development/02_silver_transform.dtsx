            <component
              refId="Package\05_load_silver_order_reviews\OLE DB Source_read_bronze_order_reviews"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source_read_bronze_order_reviews"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH CleanReviews AS
(
    SELECT
        NULLIF(LTRIM(RTRIM(review_id)), N'') AS review_id_clean,
        NULLIF(LTRIM(RTRIM(order_id)), N'') AS order_id_clean,
        TRY_CONVERT(tinyint, NULLIF(LTRIM(RTRIM(review_score)), N''))
            AS review_score_clean,
        NULLIF(LTRIM(RTRIM(CAST(review_comment_title AS nvarchar(max)))), N'')
            AS review_comment_title_clean,
        NULLIF(LTRIM(RTRIM(CAST(review_comment_message AS nvarchar(max)))), N'')
            AS review_comment_message_clean,
        TRY_CONVERT(datetime2(7),
            NULLIF(LTRIM(RTRIM(review_creation_date)), N''), 121)
            AS review_creation_date_clean,
        TRY_CONVERT(datetime2(7),
            NULLIF(LTRIM(RTRIM(review_answer_timestamp)), N''), 121)
            AS review_answer_timestamp_clean
    FROM bronze.order_reviews
)
