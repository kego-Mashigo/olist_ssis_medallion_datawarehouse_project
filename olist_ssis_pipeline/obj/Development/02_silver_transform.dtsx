            <component
              refId="Package\05_load_silver_order_items\read_bronze_order_items"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="read_bronze_order_items"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH cleaned AS
(
    SELECT
        NULLIF(LTRIM(RTRIM(b.order_id)), N'') AS order_id_clean,
        NULLIF(LTRIM(RTRIM(b.order_item_id)), N'') AS order_item_id_text,
        NULLIF(LTRIM(RTRIM(b.product_id)), N'') AS product_id_clean,
        NULLIF(LTRIM(RTRIM(b.seller_id)), N'') AS seller_id_clean,
        NULLIF(LTRIM(RTRIM(b.shipping_limit_date)), N'') AS shipping_limit_date_text,
        NULLIF(LTRIM(RTRIM(b.price)), N'') AS price_text,
        NULLIF(LTRIM(RTRIM(b.freight_value)), N'') AS freight_value_text,
        (
            SELECT b.order_id, b.order_item_id, b.product_id, b.seller_id,
                   b.shipping_limit_date, b.price, b.freight_value
            FOR JSON PATH, INCLUDE_NULL_VALUES, WITHOUT_ARRAY_WRAPPER
        ) AS raw_row
    FROM bronze.order_items AS b
),
typed AS
(
    SELECT *,
        TRY_CONVERT(int, order_item_id_text) AS order_item_id_num,
        TRY_CONVERT(datetime2(7), shipping_limit_date_text, 120) AS shipping_limit_date_clean,
        TRY_CONVERT(decimal(10,2), price_text) AS price_num,
        TRY_CONVERT(decimal(10,2), freight_value_text) AS freight_value_num
    FROM cleaned
),
validated AS
(
    SELECT *,
        CASE
            WHEN order_id_clean IS NULL THEN N'Missing order_id'
            WHEN order_item_id_num IS NULL
              OR order_item_id_num &lt;= 0
              OR order_item_id_text COLLATE Latin1_General_100_BIN2 LIKE N'%[^0-9]%'
                THEN N'order_item_id must be a positive whole number'
            WHEN product_id_clean IS NULL THEN N'Missing product_id'
            WHEN seller_id_clean IS NULL THEN N'Missing seller_id'
            WHEN shipping_limit_date_text IS NOT NULL
             AND shipping_limit_date_clean IS NULL
                THEN N'Invalid shipping_limit_date'
            WHEN price_num IS NULL THEN N'Missing or invalid price'
            WHEN TRY_CONVERT(decimal(38,18), price_text) &lt; 0 THEN N'Negative price'
            WHEN freight_value_num IS NULL THEN N'Missing or invalid freight_value'
            WHEN TRY_CONVERT(decimal(38,18), freight_value_text) &lt; 0
                THEN N'Negative freight_value'
        END AS validation_reason
    FROM typed
),
checked_keys AS
(
    SELECT *,
        COUNT(CASE WHEN validation_reason IS NULL THEN 1 END) OVER
        (
            PARTITION BY order_id_clean, order_item_id_num
        ) AS valid_rows_for_key
    FROM validated
)
SELECT
    order_id_clean,
    order_item_id_num,
    product_id_clean,
    seller_id_clean,
    shipping_limit_date_clean,
    price_num,
    freight_value_num,
    CAST(CONCAT(order_id_clean, N'|', order_item_id_text) AS nvarchar(255)) AS source_key,
    CAST(COALESCE(validation_reason,
        CASE WHEN valid_rows_for_key &gt; 1
             THEN N'Duplicate order_id and order_item_id'
             ELSE N''
        END) AS nvarchar(200)) AS error_reason,
    raw_row
FROM checked_keys;</property>
                <property
                  dataType="System.String"
                  description="The variable that contains the SQL command to be executed."
                  name="SqlCommandVariable"></property>
                <property
                  dataType="System.Int32"
                  description="Specifies the column code page to use when code page information is unavailable from the data source."
                  name="DefaultCodePage">1252</property>
                <property
                  dataType="System.Boolean"
                  description="Forces the use of the DefaultCodePage property value when describing character data."
                  name="AlwaysUseDefaultCodePage">false</property>
