    <DTS:Executable
      DTS:refId="Package\Add_missing_category_translations"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{2E9739B3-A58D-45D7-991C-75FCCA709577}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Add_missing_category_translations"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{AF4DE829-2536-4DF1-8C1C-CCE21AE20211}"
          SQLTask:SqlStatementSource="INSERT INTO silver.category_translation&#xA;    (product_category_name, product_category_name_english)&#xA;SELECT&#xA;    v.product_category_name,&#xA;    v.product_category_name_english&#xA;FROM (VALUES&#xA;    (N'pc_gamer', N'gaming_pc'),&#xA;    (N'portateis_cozinha_e_preparadores_de_alimentos',&#xA;     N'portable_kitchen_and_food_preparation_appliances')&#xA;) AS v (product_category_name, product_category_name_english)&#xA;WHERE NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM silver.category_translation AS t&#xA;    WHERE t.product_category_name = v.product_category_name&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
