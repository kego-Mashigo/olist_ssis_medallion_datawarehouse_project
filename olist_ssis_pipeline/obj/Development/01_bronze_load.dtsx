      DTS:ObjectName="00_createdb_olist_dwh"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{AF4DE829-2536-4DF1-8C1C-CCE21AE20211}"
          SQLTask:SqlStatementSource="USE MASTER&#xA;&#xA;-- Create the staging database if it does not exist.&#xA;IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM sys.databases&#xA;    WHERE name = N'olist_dwh'&#xA;)&#xA;BEGIN&#xA;    CREATE DATABASE [olist_dwh];&#xA;END;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\01_create_bronze_schema"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{1A034583-BAC9-4265-8E0D-69D1251128C1}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="01_create_bronze_schema"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{AF4DE829-2536-4DF1-8C1C-CCE21AE20211}"
          SQLTask:SqlStatementSource="-- Create the bronze schema in the staging database.&#xA;&#xA;IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM sys.schemas&#xA;    WHERE name = N'bronze'&#xA;)&#xA;BEGIN&#xA;    EXEC(N'CREATE SCHEMA [bronze]');&#xA;END;&#xA;&#xA;&#xA;-- Create the silver and gold schemas in the data warehouse.&#xA;&#xA;IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM sys.schemas&#xA;    WHERE name = N'silver'&#xA;)&#xA;BEGIN&#xA;    EXEC(N'CREATE SCHEMA [silver]');&#xA;END;&#xA;&#xA;&#xA;IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM sys.schemas&#xA;    WHERE name = N'gold'&#xA;)&#xA;BEGIN&#xA;    EXEC(N'CREATE SCHEMA [gold]');&#xA;END;&#xA;&#xA;IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM sys.schemas&#xA;    WHERE name = N'etl'&#xA;)&#xA;BEGIN&#xA;    EXEC(N'CREATE SCHEMA [etl];');&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\02_01_0_truncate_bronze_tables"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{AF7519F6-0AAB-47FE-AB88-0CC871BE15AF}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="02_01_0_truncate_bronze_tables"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{AF4DE829-2536-4DF1-8C1C-CCE21AE20211}"
          SQLTask:SqlStatementSource="TRUNCATE TABLE [bronze].[customers];&#xA;TRUNCATE TABLE [bronze].[geolocation];&#xA;TRUNCATE TABLE [bronze].[order_items];&#xA;TRUNCATE TABLE [bronze].[order_payments];&#xA;TRUNCATE TABLE [bronze].[order_reviews];&#xA;TRUNCATE TABLE [bronze].[orders];&#xA;TRUNCATE TABLE [bronze].[products];&#xA;TRUNCATE TABLE [bronze].[sellers];&#xA;TRUNCATE TABLE [bronze].[product_category_name_translation];" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
