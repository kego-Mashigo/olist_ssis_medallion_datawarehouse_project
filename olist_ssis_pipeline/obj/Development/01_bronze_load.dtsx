      DTS:ThreadHint="3">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{AF4DE829-2536-4DF1-8C1C-CCE21AE20211}"
          SQLTask:SqlStatementSource="&#xA;----1. Customers&#xA;IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM sys.tables&#xA;    WHERE name = N'customers'&#xA;      AND schema_id = SCHEMA_ID(N'bronze')&#xA;)&#xA;BEGIN&#xA;    CREATE TABLE [bronze].[customers]&#xA;    (&#xA;        [customer_id]                  NVARCHAR(50),&#xA;        [customer_unique_id]           NVARCHAR(50),&#xA;        [customer_zip_code_prefix]     NVARCHAR(50),&#xA;        [customer_city]                NVARCHAR(255),&#xA;        [customer_state]               NVARCHAR(50),&#xA;&#xA;        [dwh_load_ts]                  DATETIME2 DEFAULT SYSDATETIME(),&#xA;        [dwh_source_file]              NVARCHAR(260),&#xA;        [dwh_batch_id]                 INT&#xA;    );&#xA;END;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
