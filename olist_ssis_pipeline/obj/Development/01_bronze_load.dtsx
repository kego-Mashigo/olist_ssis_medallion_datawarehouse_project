        <SQLTask:SqlTaskData
          SQLTask:Connection="{AF4DE829-2536-4DF1-8C1C-CCE21AE20211}"
          SQLTask:SqlStatementSource="-- 9. Product category name translation&#xA;IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM sys.tables&#xA;    WHERE name = N'product_category_name_translation'&#xA;      AND schema_id = SCHEMA_ID(N'bronze')&#xA;)&#xA;BEGIN&#xA;    CREATE TABLE [bronze].[product_category_name_translation]&#xA;    (&#xA;        [product_category_name]          NVARCHAR(255),&#xA;        [product_category_name_english]  NVARCHAR(255),&#xA;&#xA;        [dwh_load_ts]                    DATETIME2 DEFAULT SYSDATETIME(),&#xA;        [dwh_source_file]                NVARCHAR(260),&#xA;        [dwh_batch_id]                   INT&#xA;    );&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
