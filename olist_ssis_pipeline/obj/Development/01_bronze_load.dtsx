      DTS:ThreadHint="4">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{AF4DE829-2536-4DF1-8C1C-CCE21AE20211}"
          SQLTask:SqlStatementSource="-- 3. Order items&#xA;IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM sys.tables&#xA;    WHERE name = N'order_items'&#xA;      AND schema_id = SCHEMA_ID(N'bronze')&#xA;)&#xA;BEGIN&#xA;    CREATE TABLE [bronze].[order_items]&#xA;    (&#xA;        [order_id]                     NVARCHAR(50),&#xA;        [order_item_id]                NVARCHAR(50),&#xA;        [product_id]                   NVARCHAR(50),&#xA;        [seller_id]                    NVARCHAR(50),&#xA;        [shipping_limit_date]          NVARCHAR(100),&#xA;        [price]                        NVARCHAR(100),&#xA;        [freight_value]                NVARCHAR(100),&#xA;&#xA;        [dwh_load_ts]                  DATETIME2 DEFAULT SYSDATETIME(),&#xA;        [dwh_source_file]              NVARCHAR(260),&#xA;        [dwh_batch_id]                 INT&#xA;    );&#xA;END;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
