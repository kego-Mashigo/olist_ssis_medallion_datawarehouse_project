            c.[customer_zip_code_prefix],
            c.[customer_city],
            c.[customer_state]
        FOR JSON PATH, WITHOUT_ARRAY_WRAPPER, INCLUDE_NULL_VALUES
    ) AS [raw_row]

FROM [bronze].[customers] AS c;</property>
