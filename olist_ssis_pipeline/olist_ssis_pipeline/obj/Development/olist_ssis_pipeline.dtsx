        <SQLTask:SqlTaskData
          SQLTask:Connection="{B427C422-F160-4E2F-9B15-CB982FF9E0B1}"
          SQLTask:SqlStatementSource="USE [olist_stg];&#xA;GO&#xA;&#xA;-- Create the order_items table only if it does not already exist.&#xA;IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM sys.tables&#xA;    WHERE name = N'rawdata_order_items'&#xA;      AND schema_id = SCHEMA_ID(N'bronze')&#xA;)&#xA;BEGIN&#xA;    CREATE TABLE [bronze].[rawdata_order_items]&#xA;    (&#xA;        [order_id]             VARCHAR(50),&#xA;        [order_item_id]       INT,&#xA;        [product_id] VARCHAR(50),&#xA;        [seller_id]            VARCHAR(50),&#xA;        [shipping_limit_date]          DATETIME,&#xA;        [price]   FLOAT ,&#xA;        [freight_value] FLOAT&#xA;    );&#xA;END;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
