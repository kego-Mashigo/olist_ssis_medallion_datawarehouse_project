        <SQLTask:SqlTaskData
          SQLTask:Connection="{B427C422-F160-4E2F-9B15-CB982FF9E0B1}"
          SQLTask:SqlStatementSource="USE [olist_stg];&#xA;GO&#xA;&#xA;-- Create the order_reviews table only if it does not already exist.&#xA;IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM sys.tables&#xA;    WHERE name = N'rawdata_order_reviews'&#xA;      AND schema_id = SCHEMA_ID(N'bronze')&#xA;)&#xA;BEGIN&#xA;    CREATE TABLE [bronze].[rawdata_order_reviews]&#xA;    (&#xA;&#xA;[review_id]              NVARCHAR(50) NULL,&#xA;[order_id]               NVARCHAR(50) NULL,&#xA;[review_score]           INT NULL,&#xA;[review_comment_title]   NVARCHAR(100) NULL,&#xA;[review_comment_message] NVARCHAR(1000) NULL,&#xA;[review_creation_date]   DATETIME NULL,&#xA;[review_answer_timestamp] DATETIME NULL&#xA;        &#xA;    );&#xA;END;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
