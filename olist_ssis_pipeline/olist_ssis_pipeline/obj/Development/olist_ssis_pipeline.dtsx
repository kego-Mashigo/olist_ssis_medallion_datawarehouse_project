          SQLTask:SqlStatementSource="USE [olist_stg];&#xA;GO&#xA;&#xA;-- Create the orders table only if it does not already exist.&#xA;IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM sys.tables&#xA;    WHERE name = N'rawdata_orders'&#xA;      AND schema_id = SCHEMA_ID(N'bronze')&#xA;)&#xA;BEGIN&#xA;    CREATE TABLE [bronze].[rawdata_orders]&#xA;    (&#xA;        [order_id]             VARCHAR(50) NULL,&#xA;        [customer_id]       VARCHAR(50) NULL,&#xA;        [order_status] VARCHAR(50) NULL,&#xA;        [order_purchase_timestamp]  DATETIME NULL,&#xA;        [order_approved_at]  DATETIME NULL,&#xA;        [order_delivered_carrier_date]  DATETIME NULL,&#xA;        [order_delivered_customer_date]  DATETIME NULL,&#xA;        [order_estimated_delivery_date]  DATETIME NULL&#xA;    );&#xA;END;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
