      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{B427C422-F160-4E2F-9B15-CB982FF9E0B1}"
          SQLTask:SqlStatementSource="-- Create the bronze schema in the staging database.&#xA;USE [olist_stg];&#xA;GO&#xA;&#xA;IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM sys.schemas&#xA;    WHERE name = N'bronze'&#xA;)&#xA;BEGIN&#xA;    EXEC(N'CREATE SCHEMA [bronze]');&#xA;END;&#xA;GO&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
