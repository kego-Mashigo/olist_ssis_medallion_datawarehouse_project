          SQLTask:SqlStatementSource="USE [olist_stg];&#xA;GO&#xA;&#xA;-- Create the order_payment table only if it does not already exist.&#xA;IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM sys.tables&#xA;    WHERE name = N'rawdata_order_payments'&#xA;      AND schema_id = SCHEMA_ID(N'bronze')&#xA;)&#xA;BEGIN&#xA;    CREATE TABLE [bronze].[rawdata_order_payments]&#xA;    (&#xA;        [order_id]             VARCHAR(50),&#xA;        [payment_sequential]       INT,&#xA;        [payment_type] VARCHAR(50),&#xA;        [payment_installments]   FLOAT,&#xA;        [payment_value]  DECIMAL&#xA;    );&#xA;END;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
