      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{B427C422-F160-4E2F-9B15-CB982FF9E0B1}"
          SQLTask:SqlStatementSource="USE [olist_stg];&#xA;GO&#xA;&#xA;-- Create the customers table only if it does not already exist.&#xA;IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM sys.tables&#xA;    WHERE name = N'rawdata_customers'&#xA;      AND schema_id = SCHEMA_ID(N'bronze')&#xA;)&#xA;BEGIN&#xA;    CREATE TABLE [bronze].[rawdata_customers]&#xA;    (&#xA;        [customer_id]              VARCHAR(50),&#xA;        [customer_unique_id]       VARCHAR(50),&#xA;        [customer_zip_code_prefix] VARCHAR(5),&#xA;        [customer_city]            VARCHAR(50),&#xA;        [customer_state]           VARCHAR(50)&#xA;    );&#xA;END;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
