        <SQLTask:SqlTaskData
          SQLTask:Connection="{B427C422-F160-4E2F-9B15-CB982FF9E0B1}"
          SQLTask:SqlStatementSource="USE MASTER&#xA;&#xA;-- Create the staging database if it does not exist.&#xA;IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM sys.databases&#xA;    WHERE name = N'olist_stg'&#xA;)&#xA;BEGIN&#xA;    CREATE DATABASE [olist_stg];&#xA;END;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
